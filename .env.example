# The site is static: there are no server-side secrets.
# The Supabase anon key is PUBLIC by design; access is enforced by Postgres RLS.
# NEVER place a service_role key in this repo or in any browser file.
#
# For local development against an ISOLATED dev project, create admin/config.local.mjs (git-ignored):
#
#   export default { url: 'https://<dev-ref>.supabase.co', anonKey: '<dev anon key>', env: 'development' };
#
# Optional: live RLS tests (tests/rls.live.test.mjs) read these. Use DEV credentials only.
YW_TEST_SUPABASE_URL=https://<dev-ref>.supabase.co
YW_TEST_ANON_KEY=<dev anon key>
YW_TEST_ADMIN_EMAIL=admin@example.com
YW_TEST_ADMIN_PASSWORD=<dev admin password>
YW_TEST_USER_EMAIL=member@example.com
YW_TEST_USER_PASSWORD=<dev ordinary user password>
